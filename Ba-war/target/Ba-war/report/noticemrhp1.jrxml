			<staticText>
				<reportElement uuid="a15c17a1-699b-47cf-8ffa-cd58e0b746a5" x="330" y="10" width="96" height="20"/>
				<textElement/>
				<text><![CDATA[suite du contrat N ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="744444ee-99e4-45fb-9f81-97bd0f179dc8" isPrintRepeatedValues="false" x="10" y="54" width="545" height="20" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$P{rach}=="1"]]></printWhenExpression>
				</reportElement>
				<textElement/>
				<text><![CDATA[- RACHAT DE L'INHABITATION (garantie  Vol  Article 3 - Paragraphe 4) :]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="8ea1ef04-456c-4ee3-8325-d44afdcf3126" isPrintRepeatedValues="false" x="10" y="74" width="545" height="33" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$P{rach}=="1"]]></printWhenExpression>
				</reportElement>
				<textElement/>
				<text><![CDATA[Sont couverts par le contrat, les dommages  résultant d'un vol commis ou tenté au cours d'une période d'inhabitation dépassant Trente (30)  jours consécutifs.]]></text>
			</staticText>
			<staticText>
