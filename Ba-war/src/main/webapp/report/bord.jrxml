	<subDataset name="New Dataset 1" uuid="6384bd59-e9e7-414c-84e9-f6f9e08c8475">
		<parameter name="ponum" class="java.lang.String"/>
		<parameter name="annee" class="java.lang.String"/>
		<queryString>
			<![CDATA[select x.mat, x.pr, x.nom, x.prenom, x.bor, sum(x.mnt) mnt, x.bul from (

select p.wpol, p.w_mat mat, p.w_pr pr, a.adnom nom , a.adpnom prenom, p.w_mrp bor ,  p.w_mbr mnt, p.w_bulp bul, p.w_dat
from princsin p inner join aderen a on
to_number(p.wpol) = a.ponum
and p.w_mat = substr(a.adpoma,11)
where p.wpol = $P{ponum}  and  p.ds  = $P{annee}


union all


select p.wpol, p.w_mat mat, p.w_pr pr, a.adnom nom , a.adpnom prenom, p.w_mrp bor ,  p.w_mbr mnt, p.w_bulp bul, p.w_dat
from compleme p inner join aderen a on
to_number(p.wpol) = a.ponum
and p.w_mat = substr(a.adpoma,11)
where p.wpol = $P{ponum}  and  p.ds  = $P{annee}


union all

                 select g.w_plc wpol, g.w_mat mat , g.w_pr pr, a.adnom nom , a.adpnom prenom, to_number(g.w_nbo) bor, 0 mnt, to_number(g.w_bulp) bul, g.w_dat
                 from gfneant g inner join aderen a on
                 to_number(g.w_plc) = a.ponum
                 and g.w_mat = substr(a.adpoma,11)
                 where g.w_plc =   $P{ponum}  and
                 g.w_dem = $P{annee}
                 and g.w_rub = 'ZZZ'

) X


group by x.wpol, x.mat, x.pr, x.nom, x.prenom, x.bor, x.bul, x.w_dat
order by x.mat, to_number(x.pr) asc]]>
		</queryString>
		<field name="MAT" class="java.lang.String"/>
		<field name="PR" class="java.lang.String"/>
		<field name="NOM" class="java.lang.String"/>
		<field name="PRENOM" class="java.lang.String"/>
		<field name="BOR" class="java.math.BigDecimal"/>
		<field name="MNT" class="java.math.BigDecimal"/>
		<field name="BUL" class="java.math.BigDecimal"/>
		<variable name="sum" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{MNT}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="ponum" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="annee" class="java.lang.String"/>
	<parameter name="img" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[select tab.TD, p.ponum, LPAD(p.sucode,'4','0') sucode, p.ponomr, substr($P{annee},7,2)||'/'||substr($P{annee},5,2)||'/'||substr($P{annee},1,4) ladate,
(pr.hrep - pr.htot )/1000 mnt , pr.htot/1000 totalremb, pr.hrep/1000 cumul
from histdep pr inner join police p on
to_number(pr.hnpol) = p.ponum


inner join

(
select count(*) TD, pol  from (
select mat, pol from (

select p.w_mat mat, p.w_pr pr, to_number(p.w_mrp) bor, p.w_bulp bul,to_number(p.wpol) pol, p.w_dat
from princsin p
where p.wpol =  $P{ponum} and  p.ds  = $P{annee}


union all


select p.w_mat mat, p.w_pr pr, to_number(p.w_mrp) bor, p.w_bulp bul,to_number(p.wpol) pol, p.w_dat
from compleme p
where p.wpol =  $P{ponum} and  p.ds  = $P{annee}


union all

   select g.w_mat mat,  g.w_pr pr,  to_number(g.w_nbo) bor,  to_number(g.w_bulp) bul , to_number(g.w_plc) pol, g.w_dat
   from gfneant g
   where g.w_plc =   $P{ponum}  and
   g.w_dem = $P{annee}
   and g.w_rub = 'ZZZ'

)
group by mat, pr,  bul, pol, bor, w_dat
) group by pol
) tab  on to_number(pr.hnpol) = tab.pol



where pr.hnpol =  $P{ponum} and  pr.hdats  = $P{annee}
--group by p.ponum, p.sucode , p.ponomr,p.porept, tab.TD]]>
	</queryString>
	<field name="TD" class="java.math.BigDecimal"/>
	<field name="PONUM" class="java.math.BigDecimal"/>
	<field name="SUCODE" class="java.lang.String"/>
	<field name="PONOMR" class="java.lang.String"/>
	<field name="LADATE" class="java.lang.String"/>
	<field name="MNT" class="java.math.BigDecimal"/>
	<field name="TOTALREMB" class="java.math.BigDecimal"/>
	<field name="CUMUL" class="java.math.BigDecimal"/>
