					<font fontName="SansSerif" size="11"/>
				</textElement>
				<text><![CDATA[Pack 3 : BNA]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="d6de2a0d-0af4-4a3d-9043-768f6218d35e" x="21" y="737" width="144" height="20"/>
				<textElement>
					<font size="11"/>
				</textElement>
				<text><![CDATA[SITUATION DU RISQUE :]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="f7b37990-4207-4351-afd7-f8c4ac7893d9" x="19" y="703" width="146" height="20"/>
				<textElement>
					<font size="11"/>
				</textElement>
				<text><![CDATA[ACTIVITE DE L’ASSURE : ]]></text>
			</staticText>
			<textField>
				<reportElement uuid="4065f269-f018-4db5-890a-b2a9fe6cf6b9" x="135" y="737" width="112" height="20"/>
				<textElement textAlignment="Right">
					<font fontName="SansSerif" size="12"/>
