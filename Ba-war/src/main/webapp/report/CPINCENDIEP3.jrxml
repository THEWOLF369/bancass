				<reportElement uuid="f4223a47-b90d-4321-a98c-c91a5c3ea75b" x="30" y="575" width="183" height="20"/>
				<textElement>
					<font fontName="SansSerif" size="13" isBold="true" isUnderline="true"/>
				</textElement>
				<text><![CDATA[I/ OBJET DE LA GARANTIE :]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="1853c9a4-feed-440b-b3fa-44c1abdcf95c" x="18" y="661" width="521" height="30"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif" size="11"/>
				</textElement>
				<text><![CDATA[la Société Tunisienne d’Assurance et de Réassurance STAR dont le siège est à Tunis, Square Avenue de Paris, garantit contre le risque INCENDIE RISQUES AGRICOLES, ce qui suit :]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="067fe65d-ff54-4cd0-a331-75207bddde2e" x="412" y="246" width="125" height="17"/>
				<textElement>
