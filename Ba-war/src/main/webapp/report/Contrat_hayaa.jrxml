			</staticText>
			<staticText>
				<reportElement uuid="d35ad166-5aaa-44d0-b7c6-6b9049c8875f" x="278" y="113" width="277" height="57"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="10" isBold="true" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[فرع التأمين :                 التأمين على الحياة                                  المنتج:                    ادخـــــــــار حــيّــة                     اتفاقية:                                                 العقد  عدد:]]></text>
