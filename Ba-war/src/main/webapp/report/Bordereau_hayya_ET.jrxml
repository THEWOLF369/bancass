<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Bordereau_prod" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3db3d9e5-799c-491c-a87f-7dde49bce4f3">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="datdeb" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="datfin" class="java.lang.String"/>
	<parameter name="libelle_agence" class="java.lang.String"/>
	<parameter name="codagc" class="java.lang.String"/>
	<parameter name="produit" class="java.lang.String"/>
	<parameter name="imagesociete" class="java.lang.String"/>
	<parameter name="cod_societ" class="java.lang.String"/>
	<parameter name="star" class="java.lang.String"/>
	<parameter name="typecontrat" class="java.lang.String"/>
	<parameter name="duree" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="commission" class="java.lang.String"/>
	<parameter name="retenue" class="java.lang.String"/>
	<parameter name="versement" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     distinct ADHESION.ID_ADHESION,
     AGENCE.CODE_AGENCE,
     QUITTANCE_TERME.DATE_DU AS ADHESION_DAT_DEBUT,
     QUITTANCE_TERME.DATE_AU AS ADHESION_DAT_FIN,
     ADHESION.DUREE AS ADHESION_DUREE,
     ADHESION.PRIMETOT AS ADHESION_MT_PRIME,
     QUITTANCE_TERME.DATE_CREATION AS ADHESION_DATE_CREATION,
     ADHESION.NADHESION AS ADHESION_NADHESION,



       QUITTANCE_DETAILS.PRIME_TOT  AS ADHESION_PRIMETOT,




     CLIENT.NOM_CLIENT || ' ' || CLIENT.PRENOM_CLIENT AS CLIENT_NOM_CLIENT,
     (QUITTANCE_DETAILS.PRIME_NETTE * (TARIF_HAYYA.taux / 100))  AS COMMISSION,

     QUITTANCE_TERME.NUMQUIT

FROM
     CLIENT,ADHESION,POLICE,PRODUIT ,UTILISATEURS,AGENCE,SOCIETE,TARIF_HAYYA,
     detail_hayya, QUITTANCE_TERME, QUITTANCE_DETAILS


WHERE


     CLIENT.ID_CLIENT = ADHESION.ID_CLIENT
 and
     ADHESION.N_POLICE = POLICE.N_POLICE

 and TARIF_HAYYA.POLICE = POLICE.N_POLICE
 AND POLICE.COD_PRODUI = PRODUIT.ID_PRODUIT
 and AGENCE.ID_AGENCE =  QUITTANCE_DETAILS.ID_AGENCE

AND AGENCE.COD_SOCIET = SOCIETE.COD_SOCIET

and ADHESION.id_adhesion = detail_hayya.id_adhesion

and QUITTANCE_TERME.ID_QUITTANCET = QUITTANCE_DETAILS.ID_QUITTANCE and QUITTANCE_DETAILS.TYPE_QUIT = 'ET'
and ADHESION.id_adhesion = QUITTANCE_TERME.id_adhesion

 and  to_date(to_char(QUITTANCE_TERME.DATE_CREATION,'mm/dd/yyyy'),'mm/dd/yyyy')  between to_date($P{datdeb},'dd/mm/yyyy') and to_date($P{datfin},'dd/mm/yyyy')
and PRODUIT.LIBELLE_PRODUIT = $P{produit}
and QUITTANCE_TERME.ETAT ='O'
and SOCIETE.COD_SOCIET = $P{cod_societ}
order by ADHESION.NADHESION]]>
	</queryString>
	<field name="ID_ADHESION" class="java.math.BigDecimal"/>
	<field name="CODE_AGENCE" class="java.lang.String"/>
	<field name="ADHESION_DAT_DEBUT" class="java.sql.Timestamp"/>
	<field name="ADHESION_DAT_FIN" class="java.sql.Timestamp"/>
	<field name="ADHESION_DUREE" class="java.math.BigDecimal"/>
	<field name="ADHESION_MT_PRIME" class="java.math.BigDecimal"/>
	<field name="ADHESION_DATE_CREATION" class="java.sql.Timestamp"/>
	<field name="ADHESION_NADHESION" class="java.lang.String"/>
	<field name="ADHESION_PRIMETOT" class="java.math.BigDecimal"/>
	<field name="CLIENT_NOM_CLIENT" class="java.lang.String"/>
	<field name="COMMISSION" class="java.math.BigDecimal"/>
	<field name="NUMQUIT" class="java.lang.String"/>
	<variable name="somprmtot" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ADHESION_PRIMETOT}]]></variableExpression>
	</variable>
	<variable name="SOMCOM" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{COMMISSION}]]></variableExpression>
	</variable>
