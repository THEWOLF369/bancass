				<textElement>
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[VIII.  Taux d’Intérêt Garanti :]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="855b2b6c-d9b3-45b8-a2e6-f92b53269a04" x="262" y="484" width="290" height="20"/>
				<textElement textAlignment="Right">
					<font fontName="Arial" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[تاريخ الإعلام السنوي بحقوق المكتتب]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="0314fa0a-c93d-4a75-8192-54e9bd48cc50" x="289" y="519" width="259" height="33"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="9"/>
				</textElement>
				<text><![CDATA[يقع إعلام المكتتب في غضون الثلاثية الثانية من كل سنة جديدة بوضعيّة العقد و حقوقه المكتسبة و التطوّر الحاصل على مستوى رأس المال المكون.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="d8930e9e-57fb-49a1-96c7-f1edbd19303c" x="12" y="480" width="248" height="46"/>
				<textElement>
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[IX. Date d’information annuelle des droits du souscripteur]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="c1f66fb5-534c-43d3-a9aa-e2b8d48c5479" x="4" y="518" width="259" height="40"/>
				<textElement textAlignment="Justified">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Le souscripteur est informé au courant du deuxième trimestre de chaque nouvelle année de la situation de son contrat et de ses droits acquis et de l’évolution de son capital constitué.]]></text>
			</staticText>
