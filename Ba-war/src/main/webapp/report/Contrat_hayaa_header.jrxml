				<text><![CDATA[VI. Décompte Prime d’assurance]]></text>
			</staticText>
			<rectangle>
				<reportElement uuid="14a51a55-6562-4835-8c34-f7b2f00eaaa5" x="0" y="153" width="554" height="59"/>
