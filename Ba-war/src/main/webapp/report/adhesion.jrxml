			<staticText>
				<reportElement uuid="96ac760c-35d0-4bda-bdc8-172e0814870e" x="3" y="554" width="538" height="41"/>
				<textElement>
					<font fontName="Serif" size="11" isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[VERSEMENT A LA BNA du solde restant dû du prêt à la date de décès ou de l’IAD de l’assuré et aux BENEFICIAIRES DESIGNES  le reste du capital assuré.]]></text>
			</staticText>
			<staticText>
