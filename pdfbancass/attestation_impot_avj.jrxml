				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["à la source sur l’IRPP."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="7a91ba68-02c9-4cd1-9314-5953c1177ece" x="43" y="242" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["a payé la somme de : <b>"+ new java.text.DecimalFormat("#,##0.000",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.FRANCE)).format($F{somme}) +" dinars</b>, durant l’année <b><u>"+$P{annee}+"</u></b> ;"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="8298a78d-8c61-4589-9e8e-c23bbd9e51b0" x="43" y="265" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["en couverture de sa prime d’assurance relative à son contrat d’assurance vie, cité ci-haut."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="82e4ba4e-c68f-4644-b53c-a3f6f9512463" x="43" y="288" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Ce contrat est établi le <b>"+$P{date_contrat}+"</b>, pour une durée de <b>"+$P{duree}+" ans</b> renouvelable, annuellement, par"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="6bdbc3ec-8fa3-4bb7-88aa-376653a5eece" x="43" y="311" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["tacite reconduction."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="0cc928ad-ebf2-4224-bc4a-988488fc7e58" x="43" y="334" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["La présente attestation est délivrée au souscripteur à la suite de sa demande, en vue de la"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="3c7ea6ba-ebfa-4de3-b769-5a19f97e0aa0" x="43" y="357" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["présenter à son employeur ou à l’administration Fiscale du Ministère des Finances ( FISQ) pour"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="4fed87e6-0207-4e90-826b-55ca83cae510" x="43" y="380" width="496" height="23"/>
				<textElement textAlignment="Justified" markup="none">
					<font fontName="Arial" size="10" isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["tenir compte de l’avantage fiscal prévu par l’article 39 du code de l’IRPP et de l’IS lors de la retenue"]]></textFieldExpression>
			</textField>
