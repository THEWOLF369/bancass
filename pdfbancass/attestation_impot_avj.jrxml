	<queryString>
		<![CDATA[select nvl(sum(nette),0) somme from (
select qd.id_adhesion, qd.prime_nette_with_surprime nette, q.DATE_CREATION from QUITTANCE q inner join QUITTANCE_DETAILS qd on
q.ID_QUITTANCE = qd.ID_QUITTANCE and q.id_adhesion = qd.id_adhesion
where qd.type_quit = 'C'
union all
select qd.id_adhesion, qd.prime_nette nette,
case
 when qd.DATE_ENC is null then q.DATE_CREATION
 else qd.DATE_ENC end as DATE_CREATION
from QUITTANCE q inner join QUITTANCE_DETAILS qd on
q.ID_QUITTANCE = qd.ID_QUITTANCE and q.id_adhesion = qd.id_adhesion
where qd.type_quit in  'VL' and qd.etat = 'O'
union all
select qd.id_adhesion, qd.prime_nette nette, qd.DATE_ENC as DATE_CREATION
from QUITTANCE_TERME qt inner join quittance_details qd on
qd.ID_QUITTANCE = qt.ID_QUITTANCET
and qd.ID_ADHESION = qt.ID_ADHESION
where qd.type_quit = 'ET' and qd.etat = 'O' and qt.ETAT = 'O'
union all
select id_adhesion, PRIME_GBASE as nette, DATE_MVT_DU as annee from V_ADHESION_QUITTANCIER

) q inner join adhesion a on
a.id_adhesion = q.id_adhesion
where a.id_adhesion = $P{id_adhesion}
and EXTRACT(YEAR FROM q.date_creation)  = $P{annee}]]>
	</queryString>
	<field name="somme" class="java.math.BigDecimal"/>
