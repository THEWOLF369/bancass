	<queryString>
		<![CDATA[SELECT LIBELLE_ACT
FROM DETAIL_ACT
JOIN PARAM_ACT ON PARAM_ACT.NUM_ACT = DETAIL_ACT.NUM_ACT
WHERE $P{age} BETWEEN PARAM_ACT.AGE_MIN AND PARAM_ACT.AGE_MAX
AND $P{capital} BETWEEN PARAM_ACT.CAPITAL_MIN AND PARAM_ACT.CAPITAL_MAX]]>
	</queryString>
	<field name="LIBELLE_ACT" class="java.lang.String"/>
